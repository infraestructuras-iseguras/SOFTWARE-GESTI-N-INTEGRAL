<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Ejecuta el backend Node.js del SGRT en Azure App Service (Windows/IIS). -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- API, health checks y acceso al backend pasan por server.js. -->
        <rule name="SGRT Node API" stopProcessing="true">
          <match url="^(api/.*|health/?|test-db/?|server\.js.*)$" />
          <action type="Rewrite" url="server.js" />
        </rule>

        <!-- Recursos estáticos del frontend recuperado. -->
        <rule name="SGRT Public Static" stopProcessing="true">
          <match url="^(js|css|assets|images|fonts)/(.*)$" />
          <action type="Rewrite" url="public/{R:0}" />
        </rule>

        <!-- La raíz y cualquier ruta SPA vuelven al index. -->
        <rule name="SGRT SPA Fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="public/index.html" />
        </rule>
      </rules>
    </rewrite>

    <httpErrors existingResponse="PassThrough" />
    <iisnode loggingEnabled="true" />
  </system.webServer>
</configuration>
